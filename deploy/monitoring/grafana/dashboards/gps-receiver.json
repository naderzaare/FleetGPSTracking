  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "دسترسی Prometheus به گیرنده (۱ = موفق)",
      "datasource": {
        "type": "prometheus",
        "uid": "gps-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"gps-receiver\"}",
          "refId": "A",
          "legendFormat": "دسترسی Prometheus به گیرنده (۱ = موفق)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
